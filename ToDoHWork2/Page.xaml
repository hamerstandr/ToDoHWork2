<UserControl x:Class="ToDoHWork2.Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Area -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Text1" 
                         Grid.Column="0"
                         Height="40" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         FontSize="14"
                         Padding="10"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="AddBtn"
                        Grid.Column="1"
                        Content="افزودن" 
                        Width="80" 
                        Click="Button_Click"
                        Margin="10,0,0,0"
                        FontSize="14"/>
            </Grid>
        </Border>

        <!-- Task List -->
        <ListView x:Name="List1" 
                  Grid.Row="1" 
                  HorizontalContentAlignment="Stretch"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Padding="10"
                            Margin="0,2"
                            BorderBrush="#e0e0e0"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Complte, Mode=TwoWay}" 
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Title}" 
                                       Grid.Column="1" 
                                       HorizontalAlignment="Left" 
                                       Margin="10,0"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                            <Button x:Name="delItem" 
                                    Click="DelItem_Click" 
                                    Grid.Column="2" 
                                    Content="✕"
                                    Width="30"
                                    Height="30"
                                    Background="#ff4444"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
